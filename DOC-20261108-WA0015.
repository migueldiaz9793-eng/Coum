const rnd=(a,b)=>a+Math.random()*(b-a),E=(x,y,a,b,c)=>{ctx.fillStyle=c;ctx.beginPath();ctx.ellipse(x,y,a,b,0,0,TAU);ctx.fill()};
let snakes=[],foods=[],me=null,state='menu',cam={x:0,y:0,z:.8},best=0,t=0,idc=0,selCol=0,vw=0,vh=0,lbT=0;
let parts=[],shake=0,rings=[],flash=0;
