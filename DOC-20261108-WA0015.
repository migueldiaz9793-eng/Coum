let autoTouch=isTouch;const KM={KeyW:'u',ArrowUp:'u',KeyS:'d',ArrowDown:'d',KeyA:'l',ArrowLeft:'l',KeyD:'r',ArrowRight:'r'},kb={u:0,d:0,l:0,r:0};
function applyMode(){const was=isTouch;isTouch=cfg.ctl==='mobile'?true:cfg.ctl==='pc'?false:autoTouch;
 $('cth').textContent='Auto detecta si juegas en móvil o en computadora. Ahora: '+(isTouch?'móvil':'computadora')+(cfg.ctl==='auto'?' (automático).':' (fijado a mano).');
 if(state==='play'&&was!==isTouch)toast(isTouch?'Controles de móvil: joystick + ⚡':'Controles de computadora: ratón/WASD + clic');
