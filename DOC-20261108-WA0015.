 if(navigator.platform==='MacIntel'&&navigator.maxTouchPoints>1)return true;
 if(mq('(pointer:coarse)')||mq('(hover:none)'))return true;
 return mq('(any-pointer:coarse)')&&!mq('(any-pointer:fine)')}
let W,H,DPR,isTouch=detTouch();
let dprMax=isTouch?1.5:2,vgC=null,lowFx=false,arenaGr=null;
