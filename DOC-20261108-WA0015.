 if(state==='play'){$('tb').style.display=isTouch?'block':'none';if(isTouch){org=joyC();ptr={x:org.x,y:org.y};showJoy()}else{org={x:W/2,y:H/2};ptr={x:W/2,y:H/2};hideJoy()}}}
addEventListener('blur',()=>{key=false;for(const k in kb)kb[k]=0});applyMode();
addEventListener('pointerdown',e=>{if(cfg.ctl!=='auto')return;const t=e.pointerType;if(t==='touch'&&!isTouch){autoTouch=true;applyMode()}else if(t==='mouse'&&isTouch&&state!=='menu'){autoTouch=false;applyMode()}else if(t==='mouse'&&isTouch&&state==='menu'&&!detTouch()){autoTouch=false;applyMode()}},true);
function joyC(){const s=cfg.jz/100;return{x:24+60*s,y:H-34-60*s}}
addEventListener('resize',()=>{if(state==='play'&&isTouch&&tp===null){org=joyC();ptr={x:org.x,y:org.y};moveJoy()}});
let RM=null,rmDone=false,net=null,ateL=[];const foodById=new Map();
try{claude.use('room').then(r=>{RM=r;rmDone=true;onlSt()},()=>{rmDone=true;onlSt()})}catch(e){rmDone=true}
let gst={id:'',name:''};try{Object.assign(gst,JSON.parse(localStorage.getItem('serp_guest')||'{}'))}catch(e){}
if(!gst.id){gst.id=Math.random().toString(36).slice(2,6).toUpperCase();gst.name='Invitado '+gst.id}
const saveG=()=>{try{localStorage.setItem('serp_guest',JSON.stringify(gst))}catch(e){}};saveG();
const okc=c=>typeof c==='string'&&/^#[0-9a-f]{6}$/i.test(c),AL='ABCDEFGHJKMNPQRSTUVWXYZ23456789',genCode=()=>Array.from({length:5},()=>AL[Math.random()*AL.length|0]).join('');
const myPeer=()=>{const p=net&&net.room.peers().find(q=>q.sameTab);return p?p.peer:null};
const skinPack=()=>({c1:skin.c1,c2:skin.c2,pat:skin.pat,eye:skin.eye,tr:skin.tr,hat:skin.hat,face:skin.face,neck:skin.neck,cc:skin.cc});
function rng32(a){return()=>{a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
function seedFoods(code){let h=2166136261;for(const c of code){h^=c.charCodeAt(0);h=Math.imul(h,16777619)}const r=rng32(h>>>0);foods.length=0;foodById.clear();
 for(let i=0;i<1700;i++){const d=Math.sqrt(r())*(R-400),a=r()*TAU,q=r(),f={x:Math.cos(a)*d,y:Math.sin(a)*d,v:q<.2?3:q<.5?2:1,c:'hsl('+(r()*360|0)+',90%,62%)',p:r()*6,id:i};foods.push(f);foodById.set(i,f)}}
function onlSt(){$('ostat').textContent=RM?'Conectado. Crea una sala o únete con un código.':rmDone?'El modo online solo funciona para personas con acceso a este juego (con sesión iniciada o invitadas).':'Conectando…';$('ocr').disabled=$('ojn').disabled=!RM;$('gid').textContent='Cuenta de invitado · #'+gst.id;$('gnm').value=gst.name;if(net)renderPl()}
function roomView(on){$('ohome').style.display=on?'none':'block';$('oroom').style.display=on?'block':'none';$('on').textContent=on?'🌐 Sala '+net.code:'🌐 Jugar online';if(on){$('ocode').textContent=net.code;renderPl()}else onlSt()}
function renderPl(){const el=$('opl');el.textContent='';if(!net)return;const ps=net.room.peers().filter(p=>p.presence&&p.presence.n);for(const p of ps){const d=document.createElement('div'),i=document.createElement('i'),s=document.createElement('span'),sk=p.presence.sk||{};i.style.background=okc(sk.c1)?sk.c1:'#b6f23a';s.textContent=String(p.presence.n).slice(0,14)+(p.sameTab?' (tú)':'')+(p.presence.pl&&p.presence.d!==1?' · jugando':'');d.append(i,s);el.appendChild(d)}$('ostat').textContent=ps.length>1?ps.length+' jugadores en la sala.':'Esperando jugadores… comparte el código.'}
async function joinRoom(code){if(!RM||net)return;code=String(code).toUpperCase().replace(/[^A-Z0-9]/g,'');if(code.length<4){$('ostat').textContent='Escribe un código válido.';return}
 const t=$('nm').value.trim();if(t){gst.name=t.slice(0,14);saveG();$('gnm').value=gst.name}
 try{$('ostat').textContent='Conectando…';const room=await RM.join('sala-'+code.toLowerCase());net={code,room,off:[]};net.off.push(room.onPeers(onNet));seedFoods(code);setBots(0);ateL=[];room.presence({pl:0,n:gst.name,sk:skinPack()}).catch(()=>{});roomView(true)}catch(e){$('ostat').textContent='No se pudo entrar a la sala. Inténtalo de nuevo.'}}
async function leaveRoom(){if(!net)return;const n=net;net=null;n.off.forEach(f=>f());try{await n.room.leave()}catch(e){}for(const s of snakes)if(s.remote)s.dead=true;foods.length=0;foodById.clear();for(let i=0;i<1700;i++){const p=spawnPos();addFood(p[0],p[1],Math.random()<.2?3:Math.random()<.5?2:1)}setBots(cfg.bots);roomView(false)}
function onNet(ch){if(!net)return;for(const p of ch.left){const s=snakes.find(x=>x.remote&&x.peer===p.peer&&!x.dead);if(s)kill(s,null)}for(const p of ch.joined.concat(ch.updated))if(!p.isMe)applyR(p);renderPl()}
function applyR(p){const r=p.presence;if(!r||!r.n)return;let s=snakes.find(x=>x.remote&&x.peer===p.peer&&!x.dead);
 if(Array.isArray(r.at))for(const id of r.at){const f=foodById.get(id);if(f)f.gone=true}
 if(r.d===1||!r.pl){if(s)kill(s,r.kb&&me&&!me.dead&&r.kb===myPeer()?me:null);return}
 if(typeof r.x!=='number'||typeof r.y!=='number')return;const m=Math.max(10,Math.min(5000,+r.m||10));
 if(!s){const k=r.sk||{},sk={c1:okc(k.c1)?k.c1:'#b6f23a',c2:okc(k.c2)?k.c2:'#2f7d12',pat:PATS.concat('rainbow').includes(k.pat)?k.pat:'plain',eye:okc(k.eye)?k.eye:'#ffe27a',tr:String(k.tr||'n'),hat:String(k.hat||'none'),face:String(k.face||'none'),neck:String(k.neck||'none'),cc:okc(k.cc)?k.cc:'#ffd24a'};
  s=mk(String(r.n).slice(0,14),false,r.x,r.y,sk);s.remote=true;s.peer=p.peer;s.a=s.ta=+r.a||0;s.mass=m;for(let i=0;i<s.seg.length;i++){s.seg[i].x=r.x-Math.cos(s.a)*i*SP;s.seg[i].y=r.y-Math.sin(s.a)*i*SP}snakes.push(s)}
 s.ta=+r.a||0;s.mass=m;s.boost=!!r.b;s.kills=r.k|0;s.nx=r.x;s.ny=r.y}
function rcorr(s,dt){if(s.nx===undefined)return;const sp=s.boost&&s.mass>12?235:125;s.nx+=Math.cos(s.ta)*sp*dt;s.ny+=Math.sin(s.ta)*sp*dt;const k=Math.min(1,dt*8),h=s.seg[0];h.x+=(s.nx-h.x)*k;h.y+=(s.ny-h.y)*k;s.x=h.x;s.y=h.y}
function netStart(){if(!net||!me)return;ateL=[];net.room.presence({pl:1,d:0,kb:null,n:me.name,sk:skinPack(),x:me.x|0,y:me.y|0,a:Math.round(me.a*100)/100,m:Math.round(me.mass),b:0,k:0,at:[]}).catch(()=>{})}
